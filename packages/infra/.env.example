# Required: 32+ char random string (openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Your root domain for multi-workspace subdomains (e.g. openheard.com). Leave blank for single-workspace.
ROOT_DOMAIN=

# Public URL of the worker. Defaults to the Cloudflare .workers.dev URL if blank. Set to your custom domain (e.g. https://openheard.com) for cross-subdomain auth cookies.
BETTER_AUTH_URL=

# External SSO endpoints. Register this site's /api/sso/callback as the provider's fixed callback.
# Webox example: https://<webox-host>/api/sso/authorize and https://<webox-host>/api/sso/token.
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
# Stable account namespace (use "webox" for Webox) and the intended owner's ID from that provider.
SSO_PROVIDER_ID=
SSO_ADMIN_USER_ID=
